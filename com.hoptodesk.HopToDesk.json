{
    "id" : "com.hoptodesk.HopToDesk",
    "runtime" : "org.freedesktop.Platform",
    "runtime-version" : "25.08",
    "sdk" : "org.freedesktop.Sdk",
    "command" : "hoptodesk",
    "finish-args" : [
        "--share=ipc",
        "--socket=x11",
        "--share=network",
        "--filesystem=home",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/man",
        "*.la"
    ],
    "modules" : [
        "shared-modules/libappindicator/libappindicator-gtk3-12.10.json",
        {
            "name": "xdotool",
            "no-autogen": true,
            "make-args": [
                "WITHOUT_RPATH_FIX=1"
            ],
            "make-install-args": [
                "PREFIX=${FLATPAK_DEST}",
                "INSTALLMAN=${FLATPAK_DEST}/share/man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/jordansissel/xdotool/archive/v3.20211022.1/xdotool-3.20211022.1.tar.gz",
                    "sha256": "82b15a944a5e82fee15e0f6116bd9f642bc3d0bb6989fc0ca5ad9dfe35de0847"
                }
            ]
        },
        {
            "name" : "libpam",
            "buildsystem" : "autotools",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/linux-pam/linux-pam/releases/download/v1.6.1/Linux-PAM-1.6.1.tar.xz",
                    "sha256" : "f8923c740159052d719dbfc2a2f81942d68dd34fcaf61c706a02c9b80feeef8e"
                }
            ]
        },
        {
            "name" : "HopToDesk",
            "buildsystem" : "simple",
            "build-commands" : [
                "bsdtar -Oxf hoptodesk.deb data.tar.xz | bsdtar -xf -",
                "cp -r ./usr/*    /app/",
                "install -Dm644 com.hoptodesk.HopToDesk.desktop -t /app/share/applications/",
                "install -Dm644 com.hoptodesk.HopToDesk.metainfo.xml -t /app/share/metainfo/",
                "install -Dm644 com.hoptodesk.HopToDesk.svg -t /app/share/icons/hicolor/scalable/apps/"
            ],
            "sources" : [
                {
                    "type" : "file",
                    "url": "https://www.hoptodesk.com/hoptodesk.deb",
                    "sha256": "7582b2ad50352c3481cae565d5399a96dfced6d25d10b4dbd4d0ace20589d9ca"
                },
                {
                    "type" : "file",
                    "url": "https://gitlab.com/hoptodesk/hoptodesk/-/raw/ab5356ba2ce36e3ee0bab6e30cc051ad07c49ecd/res/logo.svg",
                    "sha256": "7107616c5649a5bd952479f02fb4619f764578fa8bcf54c4ea4bc5466244895b",
                    "dest-filename": "com.hoptodesk.HopToDesk.svg"
                },
                {
                    "type": "file",
                    "path": "com.hoptodesk.HopToDesk.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "com.hoptodesk.HopToDesk.desktop"
                },
                {
                    "type": "file",
                    "url": "https://gitlab.com/hoptodesk/hoptodesk/-/raw/main/LICENSE",
                    "sha256": "8486a10c4393cee1c25392769ddd3b2d6c242d6ec7928e1414efff7dfb2f07ef"
                }
            ]
        }
    ]
}
